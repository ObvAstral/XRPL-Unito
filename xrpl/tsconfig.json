{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "setup-wallets.ts",
    "escrow/**/*.ts",
    "shared/**/*.ts",
    "nft/**/*.ts",
    "agreement/**/*.ts",
    "app/**/*.ts"
  ]
}
